# =============================================================================
# Teevexa web: environment variables
# Copy this file to .env for local work. .env is git-ignored: NEVER commit real values.
# =============================================================================
#
# Where each group lives:
#   [A] Frontend (Vite)      -> local .env AND Vercel > Project > Settings > Environment Variables
#   [B] Local tooling        -> local .env only (never in Vercel, never committed)
#   [C] Edge function secrets-> Supabase only:  supabase secrets set NAME=value --project-ref <ref>
#                               or Dashboard > Edge Functions > Secrets. These are NOT read from .env.
#   [D] Auto-provided        -> Supabase injects these into every edge function. Do not set them.

# -----------------------------------------------------------------------------
# [A] FRONTEND (public by design; they are embedded in the browser bundle)
# Set the same values in Vercel for Production, Preview and Development.
# -----------------------------------------------------------------------------
# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# Supabase anon / publishable key (Dashboard > Project Settings > API). Safe to expose; RLS protects data.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Supabase project ref (the <project-ref> part of the URL)
VITE_SUPABASE_PROJECT_ID=
# Optional: Plausible domain, e.g. www.teevexa.com. Analytics load ONLY after the visitor accepts cookies.
VITE_PLAUSIBLE_DOMAIN=

# NOTE: VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY are also read at BUILD time by
# scripts/prerender.mjs and scripts/generate-sitemap.mjs to prerender published blog posts, case
# studies and jobs and to list them in the sitemap. If they are missing in Vercel the build still
# succeeds but only the static pages are prerendered. Redeploy after publishing new content.

# -----------------------------------------------------------------------------
# [B] LOCAL TOOLING (only for running the Supabase CLI on your machine)
# -----------------------------------------------------------------------------
# Database password (Dashboard > Project Settings > Database). Needed for `supabase db push`.
SUPABASE_DB_PASSWORD=
# Personal access token for CLI deploys (https://supabase.com/dashboard/account/tokens).
# Prefer `supabase login` or exporting it in your shell for one session. It acts as YOUR whole account:
# revoke it when finished, and never paste it into chats or commit it.
# SUPABASE_ACCESS_TOKEN=

# Legacy duplicates of the values in [A] (not used by the app; safe to delete)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# [C] EDGE FUNCTION SECRETS (set in Supabase, listed here only as documentation)
# Setting one:   supabase secrets set NAME=value --project-ref <project-ref>
# Checking:      supabase secrets list --project-ref <project-ref>   (shows names only)
# Do NOT put real values in this file.
# -----------------------------------------------------------------------------
# Required for email (quote confirmations, booking, alerts, quote replies). Without it emails are skipped.
#   RESEND_API_KEY=            # https://resend.com/api-keys; the sender domain teevexa.com must be verified
# Required to schedule automated-reminders. Any long random string, e.g. `openssl rand -hex 24`.
# The pg_cron job must send the same value in an `x-cron-secret` header.
#   CRON_SECRET=
# Zoom Server-to-Server OAuth app (booking creates a Zoom meeting; booking still works without it)
#   ZOOM_ACCOUNT_ID=
#   ZOOM_CLIENT_ID=
#   ZOOM_CLIENT_SECRET=
# Optional overrides
#   SITE_URL=https://www.teevexa.com   # used in email links and function redirects (default is already this)
#   ADMIN_NOTIFY_EMAIL=hello@teevexa.com  # inbox for lead / booking / contact alerts (default: teevexa@gmail.com)
# Blockchain anchoring (Teevexa Trace). Until BOTH are set, anchoring is a safe no-op.
#   POLYGON_RPC_URL=
#   POLYGON_PRIVATE_KEY=       # wallet that pays gas. Treat like cash; use a dedicated low-balance wallet.
# OPTIONAL and NOT recommended unless you accept the cost. Leave unset: the quote funnel then uses free
# keyword matching and a template reply. If you set it, visitors' project text is sent to Anthropic, so
# update the privacy policy first.
#   ANTHROPIC_API_KEY=
#   ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# -----------------------------------------------------------------------------
# [D] AUTO-PROVIDED BY SUPABASE (do not set)
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_DB_URL
# The service-role key bypasses all security rules: it must never appear in the frontend, Vercel
# variables prefixed VITE_, or any committed file.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# ALSO REMEMBER (dashboard settings, not variables)
#   - Supabase > Authentication > URL Configuration:
#       Site URL:        https://www.teevexa.com
#       Redirect URLs:   https://www.teevexa.com/reset-password  (and https://teevexa.com/reset-password)
#   - Vercel > Domains: www.teevexa.com is the primary; teevexa.com redirects to it (use 308 permanent).
# -----------------------------------------------------------------------------
